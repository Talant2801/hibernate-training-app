<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- in-memory H2, lives inside the JVM; DB_CLOSE_DELAY=-1 keeps it alive
             while the JVM runs, otherwise it vanishes when the last connection closes -->
        <property name="hibernate.connection.url">jdbc:h2:mem:books;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <property name="hibernate.connection.pool_size">5</property>

        <!-- no hand-made schema in RAM: Hibernate must build it from the entities -->
        <property name="hibernate.hbm2ddl.auto">create-drop</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.highlight_sql">true</property>

        <mapping class="org.nikita.hibernatebookpractice.entity.Book"/>
        <mapping class="org.nikita.hibernatebookpractice.entity.Publisher"/>
        <mapping class="org.nikita.hibernatebookpractice.entity.Reader"/>
    </session-factory>
</hibernate-configuration>